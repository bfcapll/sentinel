# Copy to .env (never commit). Every variable below is referenced from config/sentinel.yaml.
# `sentinel config check` lists any that are missing or empty.

# RPC: Alchemy (primary, HTTPS+WSS) and Infura / MetaMask Developer (secondary).
ALCHEMY_API_KEY=
INFURA_API_KEY=

# Telegram: three bots from @BotFather (P0 = exit now, P1 = decide within hours, P2 = daily digest).
# Chat ids are numeric (groups are negative, e.g. -1001234567890). P1 and P2 may share one chat.
TELEGRAM_P0_TOKEN=
TELEGRAM_P1_TOKEN=
TELEGRAM_P2_TOKEN=
TELEGRAM_P0_CHAT_ID=
TELEGRAM_P1_CHAT_ID=
TELEGRAM_P2_CHAT_ID=

# Healthchecks.io ping URL of the check that watches this service (https://hc-ping.com/<uuid>).
HEALTHCHECKS_PING_URL=

# Etherscan API key (verified ABIs for decoded calldata, Phase 1+) and Safe Transaction Service key.
ETHERSCAN_API_KEY=
SAFE_TX_SERVICE_API_KEY=
