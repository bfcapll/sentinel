{
  "name": "sentinel",
  "version": "0.1.0",
  "description": "On-chain holdings monitor with tiered Telegram alerts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sentinel": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js run",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "gen:fixtures": "tsx scripts/gen-fixtures.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "pino": "^10.4.0",
    "viem": "^2.57.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
